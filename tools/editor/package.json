{
  "name": "saad-blog-editor-bundle",
  "private": true,
  "description": "Builds assets/admin/editor-bundle.js and assets/sanitize-bundle.js. Run: npm install && npm run build",
  "type": "module",
  "scripts": {
    "build": "esbuild src/editor-entry.js --bundle --format=esm --minify --outfile=../../assets/admin/editor-bundle.js && esbuild src/sanitize-entry.js --bundle --format=esm --minify --outfile=../../assets/sanitize-bundle.js"
  },
  "dependencies": {
    "@tiptap/core": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "@tiptap/extension-underline": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-youtube": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/extension-character-count": "2.27.3",
    "@tiptap/extension-highlight": "2.27.3",
    "@tiptap/extension-text-style": "2.27.3",
    "@tiptap/extension-color": "2.27.3",
    "@tiptap/extension-text-align": "2.27.3",
    "@tiptap/extension-table": "2.27.3",
    "@tiptap/extension-table-row": "2.27.3",
    "@tiptap/extension-table-cell": "2.27.3",
    "@tiptap/extension-table-header": "2.27.3",
    "@tiptap/extension-task-list": "2.27.3",
    "@tiptap/extension-task-item": "2.27.3",
    "@tiptap/extension-code-block-lowlight": "2.27.3",
    "lowlight": "3.3.0",
    "dompurify": "3.2.6"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
